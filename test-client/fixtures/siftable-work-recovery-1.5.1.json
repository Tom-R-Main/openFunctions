  "findings": [
    {
      "id": "evidence-retry-key",
      "severity": "blocker",
      "finding": "submitWorkVerificationEvidence generates a new Idempotency-Key for every invocation; stable attemptId is present in input but server attempt uniqueness/conflict/reconciliation is unverified."
    },
    {
      "id": "closed-payload-drift",
      "severity": "blocker",
      "finding": "Closed hosted session replay tests terminalAction and terminalIdempotencyKey only. A changed resultSummary/artifactRefs payload with the same key is not compared before replaying stored result, despite canonical receipt duplicateBehavior advertising changed-payload rejection."
    },
    {
      "id": "api-receipt-contract",
      "severity": "blocker",
      "finding": "Client sends caller keys, but package does not establish server key namespace, dedup retention, identical/conflicting payload semantics for all operations, or authoritative receipt lookup."
    },
    {
      "id": "parser-export",
      "severity": "blocker",
      "finding": "Required canonical parser is not exposed by supported package exports; private vendored imports are not used."
    },
    {
      "id": "local-custody-not-production",
      "severity": "limitation",
      "finding": "Published default store is in memory. Hosted production session durability and retention require separate server implementation evidence."
    }
