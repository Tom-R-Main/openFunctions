{
  "id": "execufunction",
  "name": "Siftable",
  "description": "Siftable is a shared, evidence-backed work graph. Human planning and executable agent work stay distinct while projects, knowledge, relationships, datasets, governed actions, and verification remain connected.",
  "version": "0.3.0",
  "activation": {
    "onStartup": true
  },
  "setup": {
    "providers": [
      {
        "id": "execufunction",
        "authMethods": [
          "api-key"
        ],
        "envVars": [
          "SIFT_TOKEN",
          "SIFT_PAT",
          "EXF_TOKEN",
          "EXF_PAT"
        ]
      }
    ],
    "requiresRuntime": false
  },
  "uiHints": {
    "apiUrl": {
      "label": "Siftable API URL",
      "help": "Base URL for the Siftable API (default: https://siftable.io)."
    },
    "token": {
      "label": "Personal Access Token",
      "help": "Siftable PAT. Embedded adapters accept SIFT_TOKEN or SIFT_PAT; legacy EXF_TOKEN and EXF_PAT also work.",
      "sensitive": true,
      "placeholder": "sift_pat_... (legacy exf_pat_... still works)"
    },
    "workspaceId": {
      "label": "Workspace ID",
      "help": "Optional workspace ID for multi-workspace accounts."
    }
  },
  "contracts": {
