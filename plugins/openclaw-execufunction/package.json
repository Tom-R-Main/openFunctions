{
  "name": "@openfunctions/openclaw-execufunction",
  "version": "0.3.0",
  "description": "Siftable plugin for OpenClaw — a shared graph for human planning, agent work, evidence, and governed action",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "siftable",
    "execufunction",
    "tasks",
    "calendar",
    "knowledge",
    "crm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Tom-R-Main/openFunctions.git",
    "directory": "plugins/openclaw-execufunction"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "sync-contract": "node scripts/sync-contract.mjs",
    "verify": "npm run sync-contract && npm run build && node scripts/verify-contract.mjs"
  },
  "dependencies": {
    "@siftable/mcp-server": "^1.2.27",
    "typebox": "^1.3.7"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "openclaw": "2026.7.1-2",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "overrides": {
    "@siftable/mcp-server": {
      "zod": "3.25.76"
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  }
}
